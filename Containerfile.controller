# Controller image for the varve management machine. Runs the varve binary
# against the /data volume.

FROM archlinux/archlinux:latest

# Carry our own OCI metadata instead of inheriting the base image's.
# version/revision/created/documentation are cleared so no Arch Linux
# information leaks into the published image.
LABEL org.opencontainers.image.title="Varve Controller" \
      org.opencontainers.image.description="Control plane of the Varve automated packaging system" \
      org.opencontainers.image.authors="ShinKouyo <i@0x0f.dev>" \
      org.opencontainers.image.source="https://git.0x0f.dev/shkouyo/varve" \
      org.opencontainers.image.url="https://git.0x0f.dev/shkouyo/varve" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.created="" \
      org.opencontainers.image.revision="" \
      org.opencontainers.image.version="" \
      org.opencontainers.image.documentation=""

# The base image ships no package database: refresh it before
# installing anything.
RUN pacman -Sy --noconfirm

# git: pull source repositories; subversion: query SVN upstream revisions;
# openssh: ssh transport for AUR package pushes; gnupg: key hosting and
# per-task injection. repo-add/repo-remove ship with the pacman package
# already present in the base image.
RUN pacman -S --noconfirm git subversion openssh gnupg

# Controller binary. Build it beforehand with `go build ./cmd/varve`.
COPY varve /usr/bin/varve

VOLUME /data

# worker API (31759) and Web UI (31760).
EXPOSE 31759 31760

ENTRYPOINT ["varve"]
