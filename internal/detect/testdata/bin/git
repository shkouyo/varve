# Git PATH shim used by the detect pipeline tests (DETAIL §3.7 #8).
# "git ls-remote" invocations (the only place the vcs subpackage cannot
# substitute execCommand from outside) are intercepted so tests can return
# canned upstream HEAD hashes; every other invocation is forwarded to the
# real git binary. Behavior is driven by environment variables:
#
#   VARVE_TEST_GIT_HEAD  canned HEAD hash for ls-remote (empty = no HEAD)
#   VARVE_TEST_GIT_SLEEP seconds to sleep inside ls-remote (concurrency tests)
#   VARVE_TEST_GIT_TRACE file to append start/end markers (concurrency tests)
#   VARVE_REAL_GIT       path of the real git binary (default /usr/bin/git)

REAL_GIT="${VARVE_REAL_GIT:-/usr/bin/git}"

if [ "$1" = "ls-remote" ]; then
    if [ -n "$VARVE_TEST_GIT_TRACE" ]; then
        echo "start" >> "$VARVE_TEST_GIT_TRACE"
    fi
    if [ -n "$VARVE_TEST_GIT_SLEEP" ]; then
        sleep "$VARVE_TEST_GIT_SLEEP"
    fi
    if [ -n "$VARVE_TEST_GIT_HEAD" ]; then
        printf '%s\tHEAD\n' "$VARVE_TEST_GIT_HEAD"
    fi
    if [ -n "$VARVE_TEST_GIT_TRACE" ]; then
        echo "end" >> "$VARVE_TEST_GIT_TRACE"
    fi
    exit 0
fi

exec "$REAL_GIT" "$@"
